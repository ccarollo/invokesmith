[
  {
    "name": "dev.smithtasks.tasks.delete",
    "title": "Delete task",
    "description": "Move a task to trash after informed confirmation and return a recoverable audit receipt.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "idempotencyKey"
      ],
      "properties": {
        "taskId": {
          "type": "string"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 16
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "taskId",
        "deletedAt",
        "recoverableUntil",
        "auditReceipt"
      ],
      "properties": {
        "taskId": {
          "type": "string"
        },
        "deletedAt": {
          "type": "string",
          "format": "date-time"
        },
        "recoverableUntil": {
          "type": "string",
          "format": "date-time"
        },
        "auditReceipt": {
          "type": "string"
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "invokesmith/actionVersion": "0.1.0",
      "invokesmith/contractDigest": "sha256:8ace91da00c7777ea77b0e421e0a23e9dd17a2f053f0772295396312f82a91c9",
      "invokesmith/authorization": {
        "required": true,
        "actor": "user",
        "scopes": [
          "tasks:delete"
        ]
      },
      "invokesmith/effects": {
        "classifications": [
          "destructive"
        ],
        "description": "Removes the task from active views and places it in trash for 30 days.",
        "mutating": true,
        "recoveryWindow": "P30D"
      },
      "invokesmith/confirmation": {
        "required": true,
        "prompt": "Delete task {{input.taskId}}? It will remain recoverable from trash for 30 days.",
        "facts": [
          "input.taskId",
          "recoveryWindow"
        ]
      },
      "invokesmith/idempotency": {
        "mode": "key_required",
        "retrySafe": true,
        "keyField": "idempotencyKey"
      },
      "invokesmith/audit": {
        "receiptRequired": true
      }
    }
  },
  {
    "name": "dev.smithtasks.tasks.reschedule",
    "title": "Reschedule task",
    "description": "Move a task to a new due date while preserving explicit time-zone and recurrence semantics.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "dueAt",
        "timeZone",
        "idempotencyKey"
      ],
      "properties": {
        "taskId": {
          "type": "string"
        },
        "dueAt": {
          "type": "string",
          "format": "date-time"
        },
        "timeZone": {
          "type": "string",
          "description": "IANA time-zone identifier."
        },
        "recurrenceMode": {
          "enum": [
            "this_occurrence",
            "this_and_future"
          ]
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 16
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "taskId",
        "previousDueAt",
        "dueAt",
        "auditReceipt"
      ],
      "properties": {
        "taskId": {
          "type": "string"
        },
        "previousDueAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "dueAt": {
          "type": "string",
          "format": "date-time"
        },
        "auditReceipt": {
          "type": "string"
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "invokesmith/actionVersion": "0.1.0",
      "invokesmith/contractDigest": "sha256:f4b08c337add13349ed35e731052f280b1fd7781f66ec0446c1e73d798054236",
      "invokesmith/authorization": {
        "required": true,
        "actor": "user",
        "scopes": [
          "tasks:write"
        ]
      },
      "invokesmith/effects": {
        "classifications": [
          "reversible"
        ],
        "description": "Changes the task due date and can be compensated by restoring its previous schedule.",
        "mutating": true,
        "compensationAction": "dev.smithtasks.tasks.restore_schedule"
      },
      "invokesmith/confirmation": {
        "required": false
      },
      "invokesmith/idempotency": {
        "mode": "key_required",
        "retrySafe": true,
        "keyField": "idempotencyKey"
      },
      "invokesmith/audit": {
        "receiptRequired": true
      }
    }
  },
  {
    "name": "dev.smithtasks.tasks.search",
    "title": "Search tasks",
    "description": "Find tasks visible to the acting user using text and optional filters.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "projectId": {
          "type": "string"
        },
        "dueBefore": {
          "type": "string",
          "format": "date-time"
        },
        "cursor": {
          "type": "string"
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "tasks"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "invokesmith/actionVersion": "0.1.0",
      "invokesmith/contractDigest": "sha256:9187ec052aa2e9029602d873cecc7d2f9f2386d95ef1f9f308549c2282269bc8",
      "invokesmith/authorization": {
        "required": true,
        "actor": "user",
        "scopes": [
          "tasks:read"
        ]
      },
      "invokesmith/effects": {
        "classifications": [
          "read_only"
        ],
        "description": "Reads task metadata without modifying application state.",
        "mutating": false
      },
      "invokesmith/confirmation": {
        "required": false
      },
      "invokesmith/idempotency": {
        "mode": "natural",
        "retrySafe": true
      },
      "invokesmith/audit": {
        "receiptRequired": false
      }
    }
  }
]
