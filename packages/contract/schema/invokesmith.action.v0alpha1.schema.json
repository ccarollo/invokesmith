{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invokesmith.dev/schema/invokesmith.action.v0alpha1.schema.json",
  "title": "InvokeSmith Action Contract v0alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "invokesmith.dev/v0alpha1" },
    "kind": { "const": "Action" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*){2,}$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "input", "output", "errors", "authorization", "effects", "confirmation", "idempotency", "audit", "scenarios"],
      "properties": {
        "description": { "type": "string", "minLength": 12 },
        "input": { "$ref": "#/$defs/jsonSchema" },
        "output": { "$ref": "#/$defs/jsonSchema" },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/error" }
        },
        "authorization": { "$ref": "#/$defs/authorization" },
        "effects": { "$ref": "#/$defs/effects" },
        "confirmation": { "$ref": "#/$defs/confirmation" },
        "idempotency": { "$ref": "#/$defs/idempotency" },
        "audit": { "$ref": "#/$defs/audit" },
        "scenarios": {
          "type": "array",
          "items": { "$ref": "#/$defs/scenario" }
        },
        "targets": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        }
      }
    }
  },
  "$defs": {
    "jsonSchema": {
      "type": "object"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "scopes", "actor"],
      "properties": {
        "required": { "type": "boolean" },
        "scopes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "actor": { "enum": ["user", "service", "agent"] }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classifications", "description"],
      "properties": {
        "classifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["read_only", "reversible", "destructive", "financial", "external_communication", "open_world"] }
        },
        "description": { "type": "string", "minLength": 1 },
        "compensationAction": { "type": "string", "minLength": 1 },
        "recoveryWindow": { "type": "string", "minLength": 1 }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": { "type": "boolean" },
        "prompt": { "type": "string", "minLength": 1 },
        "facts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "retrySafe"],
      "properties": {
        "mode": { "enum": ["none", "natural", "key_required"] },
        "keyField": { "type": "string", "minLength": 1 },
        "retrySafe": { "type": "boolean" }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptRequired"],
      "properties": {
        "receiptRequired": { "type": "boolean" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "description", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "description": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "input", "expect"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "given": { "type": "object" },
        "input": { "type": "object" },
        "expect": { "type": "object" }
      }
    }
  }
}
